<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_van_stock_requests_form" model="ir.ui.view">
        <field name="name">van_stock_requests_form</field>
        <field name="model">stock.van.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm_van_request" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed" readonly="1"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name" readonly="True"/>
                    </h1>
                    <group>
                        <group><group>
                            <field name="counter_id" required="True"/>
                            <field name="user_id" required="True"/>
                        </group></group>
                        <group><group>
                            <field name="source_location_id" required="True"/>
                            <field name="destination_location_id" required="True"/>
                            </group><group>
                            <button name="action_load_product_from_source" class="btn-primary" invisible="source_location_id == False" type="object" string="Products"/>
                        </group></group>
                        <group><group>
                            <field name="request_date"/>
                        </group></group>
                        <group><group>
                            <field name="stock_type" required="True"/>
                        </group></group>
                    </group>
                    <group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="product_line_ids">
                                <list editable="bottom">
                                    <field name="product_id" required="True"/>
                                    <field name="source_location_id" required="True"/>
<!--                                    <field name="source_quantity"/>-->
                                    <field name="quantity"/>
                                    <field name="unit"/>
                                </list>
                            </field>
                        </page>
                        <page string="Internal Transfers">
                            <field name="internal_transfer_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="location_id" string="From"/>
                                    <field name="location_dest_id" string="To"/>
                                    <field name="scheduled_date"/>
<!--                                    <field name="origin"/>-->
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_van_stock_requests_tree" model="ir.ui.view">
        <field name="name">van_stock_requests_tree</field>
        <field name="model">stock.van.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Request"/>
                <field name="user_id"/>
                <field name="source_location_id" string="From"/>
                <field name="destination_location_id" string="To"/>
                <field name="counter_id"/>
                <field name="stock_type"  widget="badge" decoration-info="stock_type == 'request_stock'" decoration-success="stock_type == 'return_stock'"/>
                <field name="state" widget="badge" decoration-warning="state == 'draft'" decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>
    <record id="van_stock_requests_search_view" model="ir.ui.view">
        <field name="name">stock.van.request.search</field>
        <field name="model">stock.van.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
            </search>
        </field>
    </record>
<!--    Action    -->
    <record id="action_van_stock_requests" model="ir.actions.act_window">
        <field name="name">Van Stock Requests</field>
        <field name="res_model">stock.van.request</field>
        <field name="view_mode">list,form</field>
    </record>
<!--    Menu    -->
    <menuitem
            id="menu_van_stock_operations"
            name="Van Stock Operations"
            parent="stock.menu_stock_warehouse_mgmt"
            sequence="2"
    />
    <menuitem
            id="menu_van_stock_requests"
            name="Van Stock Requests"
            parent="menu_van_stock_operations"
            sequence="2"
            action="action_van_stock_requests"
    />
</odoo>